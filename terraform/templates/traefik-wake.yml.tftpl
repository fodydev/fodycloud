# Generated by Terraform — catch-all for student app hosts. App containers
# have their own (higher priority) routers; when an app is sleeping, stopped
# or unknown its host falls through to the control plane, which wakes it up
# or shows a friendly page.
http:
  routers:
    app-wake:
      rule: 'HostRegexp(`${apps_host_regex}`)'
      priority: 1
      entryPoints: [websecure]
      service: control-plane@docker
      middlewares: [security-headers]
      # HostRegexp gives ACME no domain to request: the app's own certificate
      # (already obtained by its router) is served by SNI, else the default one.
      tls: {}
