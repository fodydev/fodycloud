# Generated by Terraform — Traefik static configuration
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO

accessLog:
  bufferingSize: 100

ping: {}

# Prometheus metrics on an internal entrypoint (edge network only, never
# published): the control plane reads per-service request counters to put
# idle apps to sleep.
metrics:
  prometheus:
    entryPoint: metrics
    addServicesLabels: true
    addEntryPointsLabels: false
    addRoutersLabels: false

entryPoints:
  metrics:
    address: ":8082"
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
%{ if dns01_enabled ~}
      # One wildcard certificate covers every free student subdomain.
      tls:
        certResolver: dns
        domains:
          - main: "apps.${base_domain}"
            sans:
              - "*.apps.${base_domain}"
%{ else ~}
      tls: {}
%{ endif ~}
    transport:
      respondingTimeouts:
        readTimeout: 60s
        writeTimeout: 60s
        idleTimeout: 180s

providers:
  docker:
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false
    network: fodycloud-apps
    watch: true
  file:
    directory: /etc/traefik/dynamic
    watch: true
%{ if acme_enabled }
certificatesResolvers:
  # HTTP-01: one certificate per hostname. Used for student custom domains.
  http:
    acme:
      email: "${acme_email}"
      storage: /acme/acme-http.json
%{ if acme_ca_server != "" ~}
      caServer: ${acme_ca_server}
%{ endif ~}
%{ if acme_cert_hours > 0 ~}
      certificatesDuration: ${acme_cert_hours}
%{ endif ~}
      httpChallenge:
        entryPoint: web
%{ if dns01_enabled }
  # DNS-01: wildcard certificate for *.apps.<base_domain>.
  dns:
    acme:
      email: "${acme_email}"
      storage: /acme/acme-dns.json
%{ if acme_ca_server != "" ~}
      caServer: ${acme_ca_server}
%{ endif ~}
%{ if acme_cert_hours > 0 ~}
      certificatesDuration: ${acme_cert_hours}
%{ endif ~}
      dnsChallenge:
        provider: ${acme_dns_provider}
%{ endif }
%{ endif }
