# Generated by OpenTofu: who may connect to the students' PostgreSQL server
# (apps-postgres). First match wins.
# Inside the container (backups, admin shells).
local   all       all                           trust
# The superuser only from the control plane's appsdb network.
host    all       fcadmin   ${appsdb_subnet}    scram-sha-256
host    all       all       ${appsdb_subnet}    reject
host    all       fcadmin   0.0.0.0/0           reject
# Each app's role only to the database of the same name (app_<id>), from the
# apps network.
host    sameuser  all       ${apps_subnet}      scram-sha-256
